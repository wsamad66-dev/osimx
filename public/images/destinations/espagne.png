<svg width="1200" height="800" xmlns="http://www.w3.org/2000/svg">
  <!-- Background gradient - Spanish colors theme -->
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#dc2626;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#ea580c;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#f59e0b;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="sunGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#fbbf24;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#f59e0b;stop-opacity:1" />
    </linearGradient>
    <radialGradient id="lightGrad" cx="30%" cy="30%" r="70%">
      <stop offset="0%" style="stop-color:#ffffff;stop-opacity:0.3" />
      <stop offset="100%" style="stop-color:#000000;stop-opacity:0" />
    </radialGradient>
  </defs>
  
  <!-- Background -->
  <rect width="1200" height="800" fill="url(#bgGrad)"/>
  
  <!-- Light overlay -->
  <ellipse cx="400" cy="300" rx="500" ry="400" fill="url(#lightGrad)"/>
  
  <!-- Spanish flag stripes (decorative) -->
  <rect x="0" y="0" width="1200" height="10" fill="#c60b1e"/>
  <rect x="0" y="10" width="1200" height="20" fill="#ffc400"/>
  <rect x="0" y="30" width="1200" height="10" fill="#c60b1e"/>
  
  <!-- Sagrada Familia silhouette -->
  <g opacity="0.25" transform="translate(400, 180)">
    <!-- Central tower -->
    <rect x="180" y="50" width="40" height="350" fill="#7c2d12" rx="20"/>
    <polygon points="200,30 180,50 220,50" fill="#7c2d12"/>
    <!-- Side towers -->
    <rect x="120" y="120" width="30" height="280" fill="#7c2d12" rx="15"/>
    <polygon points="135,100 120,120 150,120" fill="#7c2d12"/>
    <rect x="250" y="120" width="30" height="280" fill="#7c2d12" rx="15"/>
    <polygon points="265,100 250,120 280,120" fill="#7c2d12"/>
    <!-- Outer towers -->
    <rect x="70" y="180" width="25" height="220" fill="#7c2d12" rx="12"/>
    <polygon points="82,160 70,180 95,180" fill="#7c2d12"/>
    <rect x="305" y="180" width="25" height="220" fill="#7c2d12" rx="12"/>
    <polygon points="317,160 305,180 330,180" fill="#7c2d12"/>
  </g>
  
  <!-- Spanish flag -->
  <g transform="translate(80, 80)">
    <rect width="180" height="50" fill="#c60b1e" rx="4"/>
    <rect y="50" width="180" height="70" fill="#ffc400" rx="4"/>
    <rect y="120" width="180" height="50" fill="#c60b1e" rx="4"/>
    <!-- Border -->
    <rect width="180" height="170" fill="none" stroke="white" stroke-width="3" rx="4" opacity="0.6"/>
  </g>
  
  <!-- Sun icon -->
  <g transform="translate(900, 80)">
    <circle cx="60" cy="60" r="55" fill="url(#sunGrad)" opacity="0.95"/>
    <text x="60" y="85" font-size="60" text-anchor="middle">☀️</text>
  </g>
  
  <!-- Culture icon -->
  <g transform="translate(900, 200)">
    <circle cx="60" cy="60" r="55" fill="#be123c" opacity="0.95"/>
    <text x="60" y="85" font-size="60" text-anchor="middle">🎨</text>
  </g>
  
  <!-- Education icon -->
  <g transform="translate(900, 320)">
    <circle cx="60" cy="60" r="55" fill="#ea580c" opacity="0.95"/>
    <text x="60" y="85" font-size="60" text-anchor="middle">🎓</text>
  </g>
  
  <!-- Main text -->
  <text x="600" y="650" font-family="Arial, sans-serif" font-size="90" font-weight="bold" fill="white" text-anchor="middle" style="text-shadow: 3px 3px 6px rgba(0,0,0,0.5);">
    ESPAGNE
  </text>
  <text x="600" y="710" font-family="Arial, sans-serif" font-size="32" fill="#fef3c7" text-anchor="middle" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">
    Culture • Soleil • Qualité de Vie
  </text>
  
  <!-- Stats decorative -->
  <g transform="translate(100, 600)">
    <rect width="140" height="80" fill="#7c2d12" rx="8" opacity="0.85"/>
    <text x="70" y="40" font-family="Arial" font-size="28" font-weight="bold" fill="#fbbf24" text-anchor="middle">1200+</text>
    <text x="70" y="65" font-family="Arial" font-size="14" fill="#fef3c7" text-anchor="middle">Étudiants</text>
  </g>
  
  <g transform="translate(260, 600)">
    <rect width="140" height="80" fill="#7c2d12" rx="8" opacity="0.85"/>
    <text x="70" y="40" font-family="Arial" font-size="28" font-weight="bold" fill="#fbbf24" text-anchor="middle">30+</text>
    <text x="70" y="65" font-family="Arial" font-size="14" fill="#fef3c7" text-anchor="middle">Universités</text>
  </g>
  
  <g transform="translate(420, 600)">
    <rect width="140" height="80" fill="#7c2d12" rx="8" opacity="0.85"/>
    <text x="70" y="40" font-family="Arial" font-size="28" font-weight="bold" fill="#fbbf24" text-anchor="middle">91%</text>
    <text x="70" y="65" font-family="Arial" font-size="14" fill="#fef3c7" text-anchor="middle">Réussite</text>
  </g>
  
  <!-- Decorative circles pattern -->
  <g opacity="0.15">
    <circle cx="150" cy="450" r="12" fill="white"/>
    <circle cx="185" cy="480" r="8" fill="white"/>
    <circle cx="220" cy="440" r="10" fill="white"/>
    <circle cx="190" cy="520" r="7" fill="white"/>
    <circle cx="1050" cy="500" r="12" fill="white"/>
    <circle cx="1020" cy="480" r="8" fill="white"/>
    <circle cx="1080" cy="520" r="10" fill="white"/>
    <circle cx="1040" cy="540" r="7" fill="white"/>
  </g>
  
  <!-- Wave decoration (Mediterranean feel) -->
  <path d="M 0 750 Q 200 730 400 750 T 800 750 T 1200 750" fill="none" stroke="white" stroke-width="3" opacity="0.2"/>
  <path d="M 0 770 Q 200 750 400 770 T 800 770 T 1200 770" fill="none" stroke="white" stroke-width="3" opacity="0.15"/>
</svg>
