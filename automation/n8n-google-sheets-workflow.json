{
  "name": "OSIMX - Google Sheets to Blog",
  "nodes": [
    {
      "parameters": {
        "authentication": "oAuth2",
        "operation": "appendOrUpdate",
        "documentId": "YOUR_SHEET_ID",
        "sheetName": "Blog Topics",
        "columns": "Topic,Category,Keywords,Status",
        "options": {}
      },
      "name": "Google Sheets Trigger",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 3,
      "position": [250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.Status}}",
              "operation": "equals",
              "value2": "pending"
            }
          ]
        }
      },
      "name": "Filter Pending",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [470, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "name": "Loop Topics",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [690, 300]
    },
    {
      "parameters": {
        "url": "={{$env.SITE_URL}}/api/blog/generate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.BLOG_API_SECRET}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"topic\": \"{{$json.Topic}}\",\n  \"keywords\": \"{{$json.Keywords}}\".split(',').map(k => k.trim()),\n  \"category\": \"{{$json.Category}}\",\n  \"language\": \"fr\",\n  \"length\": \"medium\"\n}",
        "options": {}
      },
      "name": "Generate Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [910, 300]
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "name": "Wait for AI",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [1130, 300]
    },
    {
      "parameters": {
        "url": "={{$env.SITE_URL}}/api/blog/create",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.BLOG_API_SECRET}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{$node['Generate Content'].json.data}}",
        "options": {}
      },
      "name": "Create Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1350, 300]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "operation": "update",
        "documentId": "YOUR_SHEET_ID",
        "sheetName": "Blog Topics",
        "range": "={{$node['Loop Topics'].json.rowNumber}}:{{$node['Loop Topics'].json.rowNumber}}",
        "options": {
          "dataStartRow": 2
        },
        "dataMode": "autoMapInputData"
      },
      "name": "Update Sheet Status",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 3,
      "position": [1570, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "Status",
              "value": "published"
            },
            {
              "name": "PublishedURL",
              "value": "={{$node['Create Post'].json.data.studioUrl}}"
            },
            {
              "name": "PublishedDate",
              "value": "={{$now.toISO()}}"
            }
          ]
        },
        "options": {}
      },
      "name": "Set Published Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [1790, 300]
    }
  ],
  "connections": {
    "Google Sheets Trigger": {
      "main": [
        [
          {
            "node": "Filter Pending",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Pending": {
      "main": [
        [
          {
            "node": "Loop Topics",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Topics": {
      "main": [
        [
          {
            "node": "Generate Content",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Content": {
      "main": [
        [
          {
            "node": "Wait for AI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for AI": {
      "main": [
        [
          {
            "node": "Create Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Post": {
      "main": [
        [
          {
            "node": "Update Sheet Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Sheet Status": {
      "main": [
        [
          {
            "node": "Set Published Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}
