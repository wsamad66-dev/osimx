# Sanity CMS Configuration for Testimonials
# Copy this file to .env.local and fill in your actual values

# Your Sanity project ID (found in sanity.json or sanity.config.ts)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here

# Sanity dataset (usually 'production' or 'development')
NEXT_PUBLIC_SANITY_DATASET=production

# API token for write operations (optional - only needed for admin features)
# Get this from: https://www.sanity.io/manage
SANITY_API_TOKEN=your_api_token_here

# How to find your Sanity Project ID:
# 1. Go to https://www.sanity.io/manage
# 2. Select your project
# 3. Copy the Project ID from the project settings

# How to get an API Token (if needed):
# 1. Go to https://www.sanity.io/manage
# 2. Select your project
# 3. Go to "API" → "Tokens"
# 4. Click "Add API token"
# 5. Give it a name and select permissions (usually "Read" is enough)
# 6. Copy the token and paste it above
